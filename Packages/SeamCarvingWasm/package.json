{
  "name": "@seemcarving/wasm",
  "version": "0.1.0",
  "description": "WebAssembly SDK for SeamCarvingSwift",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmatsuZero/SeemCarvingSwift.git",
    "directory": "Packages/SeamCarvingWasm"
  },
  "bugs": {
    "url": "https://github.com/AmatsuZero/SeemCarvingSwift/issues"
  },
  "homepage": "https://github.com/AmatsuZero/SeemCarvingSwift#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": "./dist/worker.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "stage-wasm": "node scripts/stage-wasm.mjs",
    "build": "npm run stage-wasm && rm -rf dist && tsc --emitDeclarationOnly && vite build",
    "test:unit": "vitest run && node --test tests/publish-version.spec.mjs",
    "test:pack": "node --test tests/package-contents.spec.mjs && node --test tests/packed-consumer.spec.mjs",
    "benchmark": "node --experimental-strip-types bench/benchmark.ts"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.3.0"
  }
}
